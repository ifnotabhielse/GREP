# Copy to .env.local for local runs. On Netlify, set these under Site configuration → Environment variables.

# Server-only. Supabase → Connect → "Transaction pooler" string (port 6543), with your DB password filled in.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Browser-safe. Used only for admin magic-link login.
NEXT_PUBLIC_SUPABASE_URL=https://koemlnvgbmpglnsewwpk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Email (leave empty locally: messages are logged instead of sent).
RESEND_API_KEY=
EMAIL_FROM=GREP <onboarding@resend.dev>
ADMIN_ALERT_EMAIL=

# Any long random string. Used to hash IPs for the sign-up rate limit.
IP_HASH_SALT=change-me

# Public URL, used in emails and link previews. Netlify sets URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on /privacy and /terms as the contact for questions and complaints.
NEXT_PUBLIC_CONTACT_EMAIL=
